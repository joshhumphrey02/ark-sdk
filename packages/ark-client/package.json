{
  "name": "@nerdstackgrp/ark-client",
  "version": "1.0.6",
  "description": "Ark frontend SDK — direct browser uploads with short-lived Ark authorization.",
  "license": "MIT",
  "author": "Nerdstack",
  "homepage": "https://github.com/joshhumphrey02/ark-sdk/tree/master/packages/ark-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshhumphrey02/ark-sdk.git",
    "directory": "packages/ark-client"
  },
  "bugs": {
    "url": "https://github.com/joshhumphrey02/ark-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE.upstream"
  ],
  "sideEffects": false,
  "keywords": [
    "ark",
    "upload",
    "storage",
    "browser",
    "file-upload",
    "cdn"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
