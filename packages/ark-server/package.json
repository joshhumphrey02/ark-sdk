{
  "name": "@nerdstackgrp/ark-server",
  "version": "1.0.1",
  "description": "Ark backend SDK — REST and S3-compatible access to Ark storage.",
  "license": "MIT",
  "author": "Nerdstack",
  "homepage": "https://github.com/joshhumphrey02/ark-sdk/tree/master/packages/ark-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshhumphrey02/ark-sdk.git",
    "directory": "packages/ark-server"
  },
  "bugs": {
    "url": "https://github.com/joshhumphrey02/ark-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE.upstream"
  ],
  "sideEffects": false,
  "keywords": [
    "ark",
    "s3",
    "storage",
    "sdk",
    "s3-compatible",
    "sigv4"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
