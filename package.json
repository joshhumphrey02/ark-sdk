{
  "name": "ark-sdk",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for the Ark TypeScript and Python SDKs.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build && node --test tests/*.test.mjs",
    "clean": "rm -rf packages/*/dist",
    "release": "npm run build && npm publish --workspaces --access public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
